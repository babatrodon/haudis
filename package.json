{
  "name": "haudi-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:purge": "tsx prisma/seed-demo.ts --purge",
    "db:verify": "tsx prisma/verify-seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:buchung": "cross-env NODE_OPTIONS=--conditions=react-server tsx prisma/verify-buchung.ts",
    "verify:kurse": "cross-env NODE_OPTIONS=--conditions=react-server tsx prisma/verify-kurse.ts",
    "verify:abrechnung": "cross-env NODE_OPTIONS=--conditions=react-server tsx prisma/verify-abrechnung.ts",
    "verify:breite": "tsx scripts/verify-breite.mts"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.25",
    "@hookform/resolvers": "^5.5.7",
    "@prisma/adapter-neon": "^7.9.0",
    "@prisma/client": "7",
    "@react-email/render": "^2.1.0",
    "better-auth": "^1.6.25",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "prisma": "7",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-email": "^6.9.1",
    "react-hook-form": "^7.83.0",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
