# Kopie als .env anlegen und ausfuellen. .env gehoert nicht ins Git.

# --- Neon Postgres (Region eu-central-1) ---
# Gepoolte Verbindung, Hostname enthaelt "-pooler". Nutzt die Anwendung.
DATABASE_URL="postgresql://user:passwort@ep-xxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require"
# Direkte Verbindung, Hostname OHNE "-pooler". Nutzt die Prisma CLI fuer Migrationen.
DIRECT_URL="postgresql://user:passwort@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# --- Better Auth ---
# Zufallswert, z.B. mit: openssl rand -base64 32
# Lokal und auf Vercel unterschiedliche Werte verwenden.
BETTER_AUTH_SECRET=""
# Basis-URL der Umgebung. Lokal http://localhost:3000, auf Vercel die Domain.
BETTER_AUTH_URL="http://localhost:3000"

# --- E-Mail (Resend) ---
# Ohne Schluessel wird die Bestaetigungsmail gerendert und ins Log geschrieben
# statt versendet. Die Buchung gelingt trotzdem, der Ablauf ist testbar.
RESEND_API_KEY=""
# Absender. Solange haudi.ch nicht per SPF/DKIM verifiziert ist, laesst Resend
# nur die eigene Testdomain zu. Die Antwort geht ohnehin an info@haudi.ch.
RESEND_FROM="Haudi's Fahrschule <onboarding@resend.dev>"

# --- Seed (nur fuer prisma db seed, nicht zur Laufzeit noetig) ---
# Alle Startpasswoerter mindestens 12 Zeichen.
# Sie werden nur beim erstmaligen Anlegen eines Kontos gebraucht. Ein bereits
# gesetztes Passwort ueberschreibt der Seed nie.

# Entwickler-Admin, ohne Instruktoren-Profil.
SEED_ADMIN_EMAIL="salihulorent@gmail.com"
SEED_ADMIN_NAME="Administration"
SEED_ADMIN_PASSWORD=""

# Team-Logins. Ausilia ist ADMIN und hat zusaetzlich ein Instruktoren-Profil,
# Luca und Bernadette sind INSTRUCTOR. Die uebrigen 33 Instruktoren haben
# bewusst kein Konto (Geschaeftsregel 11).
SEED_AUSILIA_PASSWORD=""
SEED_LUCA_PASSWORD=""
SEED_BERNADETTE_PASSWORD=""
