// Datenmodell Haudi's Fahrschule, siehe PLAN.md Abschnitt 4.
//
// Betraege durchgehend als Decimal(8,2) in CHF, Anzeige de-CH.
// Datum und Zeit werden UTC gespeichert und in Europe/Zurich angezeigt.
// Uhrzeiten einer Kurslektion sind Strings ("18:00"), weil sie zum Kurstag
// gehoeren und keine eigene Zeitzone haben.
//
// Prisma 7: Die Verbindung steht nicht im datasource-Block. Die CLI liest sie
// aus prisma.config.ts (DIRECT_URL), zur Laufzeit verbindet der Neon-Adapter in
// lib/db.ts ueber die gepoolte DATABASE_URL.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Nur Team-Rollen. Es gibt keine Kundenkonten (Geschaeftsregel 9).
enum Role {
  ADMIN
  INSTRUCTOR
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ARCHIVED
}

/// Wie die Anmeldung entstanden ist. Entscheidet ueber den Mailversand:
/// ONLINE und INSTRUCTOR bekommen eine Bestaetigung, PHONE nie
/// (Geschaeftsregel 4).
///
/// INSTRUCTOR heisst: ein Kursleiter hat den Schueler im Portal angemeldet und
/// ist damit automatisch der zuweisende Fahrlehrer. Eigener Wert und nicht
/// PHONE, weil die Buchungsansicht telefonisch Angemeldete markiert, damit
/// Ausilia sieht, wer nichts Schriftliches hat — das waere sonst falsch.
enum BookingSource {
  ONLINE
  PHONE
  INSTRUCTOR
}

/// Eine Buchung ist bestaetigt oder storniert, mehr gibt es nicht.
///
/// Frueher stand hier zusaetzlich WAITLIST. Die Warteliste ist seit Sprint 7
/// ein eigenes Modell: ein Wartender hat weder Adresse noch Geburtsdatum noch
/// einen Preis, und Booking verlangt alle drei. Der Enum-Wert haette nur dazu
/// eingeladen, diese Felder mit erfundenen Werten zu fuellen.
enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Wartelisten-Eintrag, Lebenslauf von links nach rechts.
///
/// Kundenentscheid 26.07.2026: Benachrichtigung mit Buchungslink, KEIN
/// automatisches Nachruecken. Die Person entscheidet selbst, ob sie den Platz
/// nimmt — deshalb gibt es EINGELADEN als eigenen Zustand und nicht nur
/// "gebucht oder nicht".
enum WaitlistStatus {
  WARTET
  EINGELADEN
  GEBUCHT
  ENTFERNT
}

/// Welle 2: Online-Zahlung ueber Payrexx. Bar bleibt immer waehlbar.
enum PaymentMethod {
  BAR
  TWINT
  KARTE
}

enum PaymentStatus {
  OFFEN
  BEZAHLT
  ERSTATTET
}

/// Team-Login. Ein User ist nie automatisch Instruktor: das Instruktoren-Profil
/// ist ein eigenes Modell und verweist optional auf einen User
/// (Geschaeftsregel 11).
///
/// Das Passwort steht NICHT hier, sondern in Account.password mit
/// providerId "credential". So verlangt es Better Auth.
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified Boolean     @default(false)
  name          String
  image         String?
  role          Role
  active        Boolean     @default(true)
  /// Erzwingt den Passwortwechsel beim naechsten Login.
  ///
  /// Die Kursleiter erhalten provisorische @haudi.ch-Adressen ohne Postfach,
  /// Passwoerter verteilt Ausilia persoenlich (PLAN.md Abschnitt 15.1). Ein
  /// von Hand weitergegebenes Passwort darf nicht dauerhaft in Umlauf bleiben.
  mustChangePassword Boolean @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  sessions      Session[]
  accounts      Account[]
  instructor    Instructor?

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

/// Kursleiter und Fahrlehrer.
///
/// Geschaeftsregel 11: Instruktor und User sind getrennte Konzepte. Die meisten
/// Instruktoren haben kein Login, deshalb ist userId optional. Wird ein Login
/// geloescht, bleibt das Profil bestehen (onDelete: SetNull) - die Person
/// arbeitet weiter, sie meldet sich nur nicht mehr an.
///
/// Kursleiter-Dropdowns und der Einsatzplan lesen ausschliesslich dieses
/// Modell, nie die User-Tabelle. Im Altsystem erschien sonst der Admin-Account
/// "LOLIT" als waehlbarer Kursleiter.
model Instructor {
  id                  String          @id @default(cuid())
  userId              String?         @unique
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName           String
  lastName            String
  /// Kuerzel wie "HaAu" oder "VaSh", erscheint in der Buchungsansicht.
  shortCode           String          @unique
  phone               String?
  provisionPerBooking Decimal         @default(50) @db.Decimal(8, 2)
  active              Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  sessions            CourseSession[]
  referredBookings    Booking[]
  lessons             Lesson[]

  @@index([active, lastName])
  @@map("instructor")
}

/// Kursart mit den Standardwerten. Der einzelne Kurs kann Preis, Material und
/// Online-Limit ueberschreiben, weil zum Beispiel der Weekend-VKU mehr kostet.
model CourseType {
  id            String   @id @default(cuid())
  /// VKU, NH, NHI, BTU, MOT_A1_A, MOT_A1, MOT_A, BOEGLE
  code          String   @unique
  name          String
  slug          String   @unique
  description   String   @db.Text
  basePrice     Decimal  @db.Decimal(8, 2)
  materialPrice Decimal  @default(0) @db.Decimal(8, 2)
  onlineLimit   Int      @default(12)
  /// Nur VKU: Lernfahrausweis obligatorisch.
  requiresLfa   Boolean  @default(false)
  /// Boegle ist gratis und ohne Anmeldung, also nicht buchbar.
  bookable      Boolean  @default(true)
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  courses       Course[]

  @@index([active, sortOrder])
  @@map("course_type")
}

/// Eine konkrete Kursdurchfuehrung mit ihren Terminen.
model Course {
  id                String          @id @default(cuid())
  courseTypeId      String
  courseType        CourseType      @relation(fields: [courseTypeId], references: [id], onDelete: Restrict)
  price             Decimal         @db.Decimal(8, 2)
  materialPrice     Decimal         @db.Decimal(8, 2)
  onlineLimit       Int
  /// Prozentsatz, 10.00 bedeutet 10 % (Kundenentscheid 26.07.2026).
  /// Der Rabatt gilt auf den Gesamtbetrag inklusive Lehrmittel.
  earlyBirdPercent  Decimal?        @db.Decimal(5, 2)
  /// Geschaeftsregel 3: Der Rabatt gilt fuer die ersten N Buchungen des Kurses,
  /// nicht bis zu einem Datum. Kundenentscheid: 5 Plaetze.
  earlyBirdSlots    Int?
  status            CourseStatus    @default(DRAFT)
  notes             String?
  printedAt         DateTime?
  /// Wann der Kurs im SARI-Portal der asa eingetragen wurde.
  /// Frist: 24 Stunden vor Kursbeginn.
  sariAngemeldetAm  DateTime?
  /// Wann die Kursbestaetigung in SARI abgeschlossen wurde.
  /// Frist: 24 Stunden nach dem letzten VKU-Termin.
  ///
  /// Beide Felder werden in Sprint 4 nur gesetzt und angezeigt. Die
  /// Erinnerung, die aus ihnen und den Terminen faellige Fristen errechnet,
  /// kommt spaeter. Sie stehen jetzt schon hier, weil eine verpasste
  /// SARI-Bestaetigung fuer die Fahrschule ein echtes Problem ist und die
  /// Erinnerung sonst ohne Datengrundlage dastuende.
  sariBestaetigtAm  DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  sessions          CourseSession[]
  bookings          Booking[]
  waitlist          WaitlistEntry[]

  @@index([status, courseTypeId])
  @@map("course")
}

/// Ein Kursblock, zum Beispiel "Di 18:00-20:00". Ein VKU besteht aus vier
/// Bloecken, ein Nothelfer Intensiv aus dreien.
model CourseSession {
  id           String      @id @default(cuid())
  courseId     String
  course       Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  date         DateTime    @db.Date
  startTime    String
  endTime      String
  /// null bedeutet "Noch nicht bestimmt". Zuweisung ausschliesslich durch den
  /// Admin (Geschaeftsregel 10).
  instructorId String?
  instructor   Instructor? @relation(fields: [instructorId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([courseId, date])
  @@index([date])
  /// Traegt die Konfliktwarnung im Einsatzplan.
  @@index([instructorId, date])
  @@map("course_session")
}

/// Eine Anmeldung. Immer Gast-Checkout, es gibt keine Kundenkonten
/// (Geschaeftsregel 9).
///
/// Geschaeftsregel 1: genau diese Felder, Telefon ist Pflicht, ein Kanton-Feld
/// gibt es bewusst nicht.
model Booking {
  id            String        @id @default(cuid())
  courseId      String
  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  salutation    String
  firstName     String
  lastName      String
  street        String
  zip           String
  city          String
  birthDate     DateTime      @db.Date
  phone         String
  /// Im Onlineformular Pflicht, bei einer telefonischen Anmeldung nicht.
  ///
  /// Am Schalter und am Telefon gibt es Leute ohne E-Mail-Adresse, vor allem
  /// bei den Nothelferkursen. Eine erfundene Adresse waere schlimmer als
  /// keine: die Bestaetigung ginge ins Leere oder an eine fremde Person.
  /// Telefon ist und bleibt Pflicht (Geschaeftsregel 1), darueber ist jede
  /// Anmeldung erreichbar.
  email         String?
  /// Lernfahrausweis-Nummer, in Schritt 2 erfassbar und spaeter nachreichbar.
  lfaNumber     String?
  agbAcceptedAt DateTime?
  smsReminder   Boolean       @default(false)
  smsPhone      String?
  /// PHONE bedeutet telefonische Anmeldung: zaehlt zur Kapazitaet, loest aber
  /// kein Bestaetigungsmail aus (Geschaeftsregel 4).
  source        BookingSource @default(ONLINE)
  status        BookingStatus @default(CONFIRMED)
  priceCharged  Decimal       @db.Decimal(8, 2)
  earlyBird     Boolean       @default(false)
  /// Zuweisender Fahrlehrer, Grundlage der Provision (Geschaeftsregel 5).
  referredById  String?
  referredBy    Instructor?   @relation(fields: [referredById], references: [id], onDelete: SetNull)
  /// Provisionssatz zum Zeitpunkt der Zuweisung, dieselbe Idee wie
  /// priceCharged: die Abrechnung eines vergangenen Monats darf sich nicht
  /// aendern, nur weil Ausilia heute einen Satz anpasst. null heisst: keine
  /// Zuweisung, also keine Provision.
  commissionRate Decimal?     @db.Decimal(8, 2)
  /// Welle 2, PLAN.md Abschnitt 14. Bis Sprint 7 immer BAR und OFFEN.
  paymentMethod PaymentMethod @default(BAR)
  paymentStatus PaymentStatus @default(OFFEN)
  paidAt        DateTime?
  payrexxRef    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  smsLogs       SmsLog[]

  /// Zaehlt die belegten Plaetze fuer die Ampel (Geschaeftsregel 2).
  @@index([courseId, status])
  /// Traegt den Doppelbuchungsschutz: gleiche E-Mail, gleicher Kurs, 10 Minuten
  /// (Geschaeftsregel 8).
  @@index([email, courseId, createdAt])
  @@index([referredById, createdAt])
  /// Globale Suche im Admin nach Name und Telefon.
  @@index([lastName])
  @@index([phone])
  @@map("booking")
}

/// Ein Platz auf der Warteliste eines ausgebuchten Kurses.
///
/// Bewusst ein eigenes Modell und keine Buchung mit anderem Status: wer sich
/// eintraegt, gibt Name, Telefon und E-Mail an, sonst nichts. Booking verlangt
/// Strasse, PLZ, Ort, Geburtsdatum und priceCharged; die muessten alle erfunden
/// werden. Kein Konto, wie ueberall (Geschaeftsregel 9).
///
/// Wird ein Platz frei, geht der aelteste wartende Eintrag auf EINGELADEN und
/// haelt den Platz bis invitedUntil. Bis dahin zaehlt er wie eine Buchung gegen
/// die Kapazitaet — sonst waere die Einladung ein Versprechen, das ein
/// beliebiger Besucher der Website einloesen kann, bevor die eingeladene Person
/// ihre Mail liest. Nach Ablauf zaehlt er nicht mehr, ohne dass jemand
/// aufraeumen muesste: die Frist wird beim Lesen ausgewertet.
model WaitlistEntry {
  id        String  @id @default(cuid())
  courseId  String
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  firstName String
  lastName  String
  phone     String
  /// Anders als bei Booking Pflicht: der ganze Zweck ist die Benachrichtigung.
  email     String

  status WaitlistStatus @default(WARTET)

  /// Einladungslink. Einmalig, deshalb unique; null, solange nicht eingeladen.
  token        String?   @unique
  invitedAt    DateTime?
  /// Bis wann der Platz reserviert ist.
  invitedUntil DateTime?

  /// Gesetzt, sobald aus dem Eintrag eine Buchung wurde. Keine Relation:
  /// wird die Buchung spaeter geloescht, soll der Eintrag nicht mitgehen — er
  /// ist der Beleg dafuer, dass die Person je auf der Liste stand.
  bookingId String?

  /// Was beim Verschicken der Einladung tatsaechlich passiert ist.
  ///
  /// Ohne RESEND_API_KEY wird nur protokolliert. Ohne diese beiden Felder
  /// stuende im Panel eine eingeladene Person, von der niemand weiss, dass sie
  /// nie eine Mail bekommen hat. Werte: "gesendet", "protokolliert", "fehler".
  mailStatus String?
  mailGrund  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Traegt die Reihenfolge der Warteschlange und das Zaehlen offener
  /// Einladungen fuer die Kapazitaet.
  @@index([courseId, status, createdAt])
  @@map("waitlist_entry")
}

/// Fahrzeugkategorie einer Lektion, PLAN.md Abschnitt 14.
/// Dieselben Kategorien wie die Preisliste in lib/fahrstunden.ts.
enum LessonCategory {
  AUTO
  TAXI
  MOTORRAD
  LKW
  ANHAENGER_BE
}

/// Lebenslauf einer Lektion.
///
/// Nur ABSOLVIERT verbraucht eine Lektion aus dem Abo. STORNIERT und NO_SHOW
/// unterscheiden sich fuer die Fahrschule: abgesagt heisst rechtzeitig
/// abgemeldet, nicht erschienen heisst der Fahrlehrer stand da. Was daraus
/// abrechnungsseitig folgt, entscheidet Ausilia von Fall zu Fall — deshalb
/// zaehlt hier keines von beiden automatisch.
enum LessonStatus {
  GEPLANT
  ABSOLVIERT
  STORNIERT
  NO_SHOW
}

/// Interne Schuelerkartei (PLAN.md Abschnitt 14).
///
/// KEIN Login, KEIN User-Bezug, keine Rolle STUDENT. Kundenentscheid vom
/// 26.07.2026: Fahrschueler buchen als Gast und sehen sonst nichts. Das hier
/// ist ein Werkzeug fuer Ausilia und die Fahrlehrer, damit jemand weiss, wer
/// welches Abo hat und wann die Pruefung war.
///
/// Bewusst getrennt von Booking: eine Kursanmeldung ist ein einzelnes
/// Ereignis, ein Fahrschueler eine Person ueber Monate. Wer einen VKU bucht,
/// nimmt nicht zwingend Fahrstunden, und wer Fahrstunden nimmt, hat vielleicht
/// nie online gebucht.
model StudentRecord {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  phone     String
  /// Ohne Adresse keine WAB-Erinnerung. Wie bei Booking kein Pflichtfeld: am
  /// Schalter gibt es Leute ohne E-Mail, und eine erfundene waere schlimmer.
  email     String?
  notes     String? @db.Text

  /// Bestandene praktische Pruefung. Basis der WAB-Frist: der Kurs muss
  /// innerhalb von zwoelf Monaten danach absolviert sein.
  practicalExamPassedAt DateTime? @db.Date

  /// Wann der Erinnerungsversuch gelaufen ist. Verhindert den Doppelversand.
  /// Gesetzt wird es auch dann, wenn nur protokolliert wurde — was wirklich
  /// passiert ist, steht daneben.
  wabReminderSentAt DateTime?
  /// "gesendet", "protokolliert" oder "fehler", wie bei WaitlistEntry.
  wabMailStatus     String?
  wabMailGrund      String?

  packages  LessonPackage[]
  lessons   Lesson[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@index([lastName])
  @@index([phone])
  /// Traegt den monatlichen Lauf der WAB-Erinnerung.
  @@index([practicalExamPassedAt, wabReminderSentAt])
  @@map("student_record")
}

/// Ein gekauftes Lektionspaket, PLAN.md Abschnitt 5: einzeln, 5er oder 10er.
///
/// Wie viele Lektionen verbraucht sind, steht NICHT hier. Verbraucht ist, was
/// an Lektionen mit Status ABSOLVIERT auf diesem Abo haengt. Ein mitgefuehrter
/// Zaehler muesste bei jedem Statuswechsel richtig nachgezogen werden, und
/// weicht er einmal ab, faellt es niemandem auf.
model LessonPackage {
  id        String        @id @default(cuid())
  studentId String
  student   StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  category LessonCategory
  /// 1, 5 oder 10 Lektionen.
  size     Int

  /// Preis pro Lektion zum Zeitpunkt des Verkaufs, dieselbe Idee wie
  /// priceCharged auf der Buchung: aendert Ausilia spaeter die Preisliste,
  /// bleibt ein verkauftes Abo, was es war.
  pricePerLesson Decimal @db.Decimal(8, 2)

  paymentMethod PaymentMethod @default(BAR)
  paymentStatus PaymentStatus @default(OFFEN)
  paidAt        DateTime?

  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, createdAt])
  @@map("lesson_package")
}

/// Eine Fahrlektion.
///
/// Die Zuweisung des Fahrlehrers macht ausschliesslich die Admin
/// (Geschaeftsregel 10, hier auf die Lektion uebertragen). Kunden waehlen nie
/// einen Fahrlehrer, und im Portal kann ein Fahrlehrer weder sich selbst noch
/// jemand anderen eintragen — er hakt ab, was ihm zugewiesen wurde.
model Lesson {
  id        String        @id @default(cuid())
  studentId String
  student   StudentRecord @relation(fields: [studentId], references: [id], onDelete: Cascade)

  instructorId String
  instructor   Instructor @relation(fields: [instructorId], references: [id], onDelete: Restrict)

  category    LessonCategory
  date        DateTime       @db.Date
  startTime   String
  durationMin Int            @default(45)
  /// Wo abgeholt wird, wenn nicht an der Haselstrasse.
  pickupNote  String?
  status      LessonStatus   @default(GEPLANT)

  /// Ohne Abo ist erlaubt und normal: die Probelektion ist gratis, und nicht
  /// jede Stunde laeuft ueber ein Paket.
  packageId String?
  package   LessonPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([studentId, date])
  /// Traegt "Meine Schueler" im Portal und die Tagesliste.
  @@index([instructorId, date])
  /// Traegt den Abo-Stand.
  @@index([packageId, status])
  @@map("lesson")
}

/// Schluessel-Wert-Speicher fuer die Einstellungen (PLAN.md Abschnitt 6.8).
/// Gelesen wird ueber lib/einstellungen.ts, das auf die Defaults zurueckfaellt.
model Setting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt

  @@map("setting")
}

/// Protokoll jeder versendeten SMS-Erinnerung (PLAN.md Abschnitt 8).
model SmsLog {
  id        String   @id @default(cuid())
  bookingId String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  to        String
  body      String   @db.Text
  status    String
  sentAt    DateTime @default(now())

  @@index([bookingId])
  @@index([sentAt])
  @@map("sms_log")
}
